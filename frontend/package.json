{
  "name": "homeassistant-gateway-ui",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "check": "tsc --noEmit",
    "check:storybook": "tsc -p tsconfig.storybook.json --noEmit",
    "test:storybook": "playwright test --config=playwright.storybook.config.ts",
    "test:runtime": "node scripts/test-runtime.mjs",
    "test:architecture": "node scripts/check-architecture-boundaries.mjs",
    "test:ux": "node scripts/test-ux-contracts.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.3.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-themes": "10.5.6",
    "@storybook/web-components-vite": "10.5.6",
    "@types/node": "^22.20.1",
    "storybook": "10.5.6",
    "typescript": "5.8.3"
  }
}
