# Copy this file to .env and keep the copy outside version control.
# Use an immutable tag or digest, not a floating latest tag.
GATEWAY_IMAGE=ghcr.io/vypdev/homeassistant-gateway:0.5.34
GATEWAY_HOME_ASSISTANT_URL=http://homeassistant:8123
GATEWAY_HOME_ASSISTANT_TOKEN=replace-with-a-long-lived-access-token
GATEWAY_HOST_PORT=8099
